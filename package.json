{
  "name": "sidepad-wifi-display",
  "version": "0.2.0",
  "private": true,
  "description": "A Windows extended display streamed to a device browser over the local network",
  "main": "src/main.cjs",
  "author": "Sidepad contributors",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/build-icons.cjs",
    "prepare:driver": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts/prepare-driver.ps1",
    "dist:win": "npm run prepare:driver && electron-builder --win nsis --x64 --publish never && node scripts/write-release-files.cjs",
    "preview": "electron . --preview",
    "preview:hardware": "electron . --hardware-preview",
    "preview:buffer": "electron . --buffer-preview",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "smoke": "electron . --smoke-test",
    "benchmark": "electron . --smoke-test --benchmark",
    "probe:codecs": "electron . --codec-probe"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  }
}
